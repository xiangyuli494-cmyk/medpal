# 复制为 .env 后填写，.env 不进仓库
# 前端只认 VITE_ 前缀的变量

VITE_API_BASE=http://127.0.0.1:8000/api/v1
VITE_WS_BASE=ws://127.0.0.1:8090

# 演示模式：1 = 全部走假适配器，不联网、不花钱
DEMO_MODE=1

# 知识图谱 LLM 选节点（可选；不配 Key 时规则层仍可用）
# 模型名必须与你的网关支持列表一致：
#   MaaS 网关用 qwen3.8-flash；官方 DashScope 用 qwen-flash
LLM_ENABLED=1
LLM_API_KEY=
LLM_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
LLM_MODEL_FAST=qwen3.8-flash
LLM_TIMEOUT=60

# 兼容旧配置；优先使用 LLM_API_KEY
DASHSCOPE_API_KEY=

# 毕设旧系统（只读，端口 8001）；没开时适配器会降级到 fixtures/legacy
LEGACY_BASE_URL=http://127.0.0.1:8001
